        <mxCell id="c18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;PSP core&lt;/b&gt; — Spring Boot · Java 25 · ×2 instance (stateless)&lt;hr&gt;&lt;table style=&#39;font-size:11px&#39;&gt;&lt;tr&gt;&lt;td valign=&#39;top&#39;&gt;• Merchant API (REST + HMAC)&lt;br&gt;• Checkout (izbor metode)&lt;br&gt;• Payment core (state machine)&lt;br&gt;• Idempotency + transactional outbox&lt;br&gt;• Plugin registry (REST / mTLS)&lt;/td&gt;&lt;td valign=&#39;top&#39; style=&#39;padding-left:12px&#39;&gt;• Webhook dispatcher (retry, backoff)&lt;br&gt;• Reconciler (status job-ovi)&lt;br&gt;• FX modul (zaključan kurs)&lt;br&gt;• Auth, RBAC, MFA (TOTP)&lt;br&gt;• Audit log (append-only)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" vertex="1">
