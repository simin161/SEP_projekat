        <mxCell id="c93" value="neuspeh / otkaz, ili potvrda posle grace → refund" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;whiteSpace=wrap;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="548" y="1192" width="140" height="32" as="geometry" />
        </mxCell>
        <mxCell id="c94" value="&lt;b&gt;Pravilo:&lt;/b&gt; važi trenutak inicijalizacije produženja. Produženje pokrenuto dok je sesija ACTIVE računa se od starog kraja (neprekidna pokrivenost), ako uplata stigne u grace periodu. Kasnija potvrda → automatski refund, sesija ostaje EXPIRED.&lt;br&gt;&lt;br&gt;&lt;b&gt;Paralelno produženje:&lt;/b&gt; CREATE UNIQUE INDEX ON extension(session_id) WHERE status = &#39;PENDING&#39; + @Version na sesiji.&lt;br&gt;&lt;br&gt;&lt;b&gt;Obaveštenje:&lt;/b&gt; posle uspešnog produženja ažurira se red u scheduled_notification (novo vreme slanja)." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="1060" width="470" height="220" as="geometry" />
        </mxCell>
