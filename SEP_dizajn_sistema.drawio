        <mxCell id="c17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" value="&lt;b&gt;nginx&lt;/b&gt;&lt;br&gt;load balancer · TLS 1.3" vertex="1">
