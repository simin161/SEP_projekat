        <mxCell id="c13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Parking servis&lt;/b&gt;&lt;br&gt;&lt;i&gt;Spring Boot · Java 25·&lt;br&gt;&lt;/i&gt;• Korisnici i autentifikacija (JWT)&lt;br&gt;• Zone, cenovnici, pravila produženja&lt;br&gt;• Vozila (registarske oznake)&lt;br&gt;• Parking nalozi + obračun cene (zamrznut iznos)&lt;br&gt;• Sesije i produženja (optimistic lock)&lt;br&gt;• PSP klijent (HMAC, Idempotency-Key)&lt;br&gt;• Prijem webhook-a (idempotentno po eventId)&lt;br&gt;• Reconciliation job (GET status od PSP-a)&lt;br&gt;• Scheduler obaveštenja (FOR UPDATE SKIP LOCKED)" vertex="1">
          <mxGeometry height="260" width="360" x="70" y="350" as="geometry" />
