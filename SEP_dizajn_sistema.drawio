        <mxCell id="c94" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Pravilo:&lt;/b&gt; važi trenutak inicijalizacije produženja. Produženje pokrenuto dok je sesija ACTIVE računa se od starog kraja (neprekidna pokrivenost), ako uplata stigne u grace periodu. Kasnija potvrda → automatski refund, sesija ostaje EXPIRED.&lt;br&gt;&lt;br&gt;&lt;b&gt;Paralelno produženje:&lt;/b&gt; CREATE UNIQUE INDEX ON extension(session_id) WHERE status = &#39;PENDING&#39; + @Version na sesiji.&lt;br&gt;&lt;br&gt;&lt;b&gt;Obaveštenje:&lt;/b&gt; posle uspešnog produženja ažurira se red u scheduled_notification (novo vreme slanja)." vertex="1">
          <mxGeometry height="220" width="470" x="720" y="1060" as="geometry" />
        </mxCell>
      </root>
