# Local development only. Copy this file to ".env" (same folder) and change the values.
# ".env" is in .gitignore. Never commit real secrets.
# These variables are read by docker-compose.yml and by the "local" profile of each service.

# PostgreSQL admin account (used only by the container, never by a service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# One password per service database (role <service>_user, database <service>_db)
PARKING_DB_PASSWORD=parking_dev
PSP_DB_PASSWORD=psp_dev
CARD_DB_PASSWORD=card_dev
PAYPAL_DB_PASSWORD=paypal_dev
CRYPTO_DB_PASSWORD=crypto_dev
BANK_DB_PASSWORD=bank_dev

# Redis (psp-core)
REDIS_PASSWORD=redis_dev
