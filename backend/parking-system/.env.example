# Local development only. Copy this file to ".env" (same folder) and change the values.
# ".env" is in .gitignore. Never commit real secrets.
# These variables are read by docker-compose.yml and by the "local" profile of the service.

# PostgreSQL admin account (used only by the container, never by the service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev

# Password of the parking database (role parking_user, database parking_db)
PARKING_DB_PASSWORD=parking_dev
