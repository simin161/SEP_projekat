        <mxCell id="s6-19" value="POST /auth/login {email, privremena lozinka}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
