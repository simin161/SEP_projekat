        <mxCell id="s6-29" value="Kod tačan za tekući ili prethodni korak (RFC 6238, sep-06 §69); korak &gt; last_totp_step (nema ponovne upotrebe, [PCI 8.5.1]). mfa_enabled = true, audit_log." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
