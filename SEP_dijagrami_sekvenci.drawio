        <mxCell id="s6-15" value="RBAC: samo SUPER_ADMIN. Jedna transakcija: merchant (novi merchant_id, api_secret šifrovan), psp_user MERCHANT_ADMIN sa privremenom lozinkom, must_change_password = true, audit_log." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="375.0" y="301" width="340" height="66" as="geometry" />
        </mxCell>
        <mxCell id="s6-16" value="201 {merchantId, apiSecret, privremena lozinka} — prikazuje se samo jednom" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
