        <mxCell id="s6-17" value="Super admin predaje podatke klijentu van sistema (predlog)." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="10.0" y="430" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s6-18" value="Korak 2: prva prijava klijenta, obavezna promena lozinke i MFA" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;align=left;spacingLeft=8;fillColor=#e6e6e6;strokeColor=#666666;" vertex="1" parent="1">
