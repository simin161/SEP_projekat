            <mxPoint x="1060.0" y="866" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-11" value="[B: T je prošlo, uspeh potvrđen u grace periodu]" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="38.0" y="869" width="1014.0" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s2-12" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="30.0" y="1144" as="sourcePoint" />
            <mxPoint x="1060.0" y="1144" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-13" value="[C: neuspeh, otkaz ili grace istekao bez potvrde]" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="38.0" y="1147" width="1014.0" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s2-14" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#666666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="30.0" y="1364" as="sourcePoint" />
            <mxPoint x="1060.0" y="1364" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-15" value="[D: uspeh stigao posle isteka grace perioda]" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="38.0" y="1367" width="1014.0" height="20" as="geometry" />
        </mxCell>
        <mxCell id="s2-16" value="Sesija je ACTIVE. end_at = T. scheduled_notification.send_at = T − notify_before_min." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="415.0" y="150" width="260" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2-17" value="e-mail: sesija ističe u T (vozilo, zona)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335.0" y="208" as="sourcePoint" />
            <mxPoint x="125.0" y="208" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-18" value="POST /sessions/{id}/extensions (trajanje)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="125.0" y="253" as="sourcePoint" />
            <mxPoint x="545.0" y="253" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-19" value="Provera: sesija ACTIVE, zona dozvoljava produženje, trajanje u granicama pravila (max_extension_min, max_extensions). Cena obračunata i zamrznuta." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380.0" y="298" width="330" height="53" as="geometry" />
        </mxCell>
        <mxCell id="s2-20" value="Jedna transakcija: INSERT parking_order (EXTENSION, PENDING_PAYMENT) + INSERT extension (PENDING, initiated_at, previous_end_at = T).&lt;br&gt;Ako za sesiju već postoji PENDING produženje: 409 (parcijalni unique indeks)." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="375.0" y="369" width="340" height="79" as="geometry" />
        </mxCell>
        <mxCell id="s2-21" value="POST /api/v1/payments (HMAC, Idempotency-Key)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545.0" y="466" as="sourcePoint" />
            <mxPoint x="755.0" y="466" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-22" value="201 {paymentId, checkoutUrl}" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="755.0" y="511" as="sourcePoint" />
            <mxPoint x="545.0" y="511" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-23" value="checkoutUrl (redirect)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545.0" y="556" as="sourcePoint" />
            <mxPoint x="125.0" y="556" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-24" value="webhook payment.succeeded (HMAC, eventId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="755.0" y="705" as="sourcePoint" />
            <mxPoint x="545.0" y="705" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-25" value="Provera iznosa i valute. extension APPLIED, end_at = T + trajanje, order COMPLETED. scheduled_notification.send_at pomeren na novi kraj." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="375.0" y="750" width="340" height="53" as="geometry" />
        </mxCell>
        <mxCell id="s2-26" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545.0" y="821" as="sourcePoint" />
            <mxPoint x="755.0" y="821" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-27" value="U trenutku T: sesija ACTIVE → EXPIRED_PENDING_EXTENSION (grace = TTL forme, npr. 10 min). Zapis u status_change." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="185.0" y="912" width="300" height="53" as="geometry" />
        </mxCell>
        <mxCell id="s2-28" value="webhook payment.succeeded (eventId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="755.0" y="983" as="sourcePoint" />
            <mxPoint x="545.0" y="983" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-29" value="Važi trenutak inicijalizacije: end_at = previous_end_at + trajanje (bez rupe u pokrivenosti). Sesija → ACTIVE, extension APPLIED, order COMPLETED." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="375.0" y="1028" width="340" height="53" as="geometry" />
        </mxCell>
        <mxCell id="s2-30" value="200 OK" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545.0" y="1099" as="sourcePoint" />
            <mxPoint x="755.0" y="1099" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-31" value="Grace istekao: sesija → EXPIRED, extension REJECTED. Plaćeno vreme ostaje nepromenjeno." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="185.0" y="1190" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2-32" value="webhook payment.expired (kad istekne Payment)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="755.0" y="1248" as="sourcePoint" />
            <mxPoint x="545.0" y="1248" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-33" value="order → EXPIRED. Nema aktivacije ni refund-a (ništa nije naplaćeno). Neuspeo pokušaj sam po sebi ne završava Payment (sep-05 §60), zato je završni signal payment.expired." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="375.0" y="1293" width="340" height="53" as="geometry" />
        </mxCell>
        <mxCell id="s2-34" value="webhook payment.succeeded (eventId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="755.0" y="1410" as="sourcePoint" />
            <mxPoint x="545.0" y="1410" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-35" value="Sesija je već EXPIRED: produženje je nemoguće. Sesija ostaje EXPIRED, order → REFUND_REQUIRED, extension REJECTED." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="375.0" y="1455" width="340" height="40" as="geometry" />
        </mxCell>
        <mxCell id="s2-36" value="refund(paymentId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545.0" y="1513" as="sourcePoint" />
            <mxPoint x="755.0" y="1513" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-37" value="refund(attemptId)" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="755.0" y="1558" as="sourcePoint" />
            <mxPoint x="965.0" y="1558" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-38" value="refund potvrđen" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="965.0" y="1603" as="sourcePoint" />
            <mxPoint x="755.0" y="1603" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-39" value="webhook refund.succeeded (eventId)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="755.0" y="1648" as="sourcePoint" />
            <mxPoint x="545.0" y="1648" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s2-40" value="order → REFUNDED." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="445.0" y="1693" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="s2-41" value="Ako webhook izostane: reconciler pita PSP (GET /payments?merchantOrderId=…) i primenjuje isto pravilo, kao u sekvenci kartice (strana 1)." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380.0" y="1765" width="330" height="53" as="geometry" />
        </mxCell>
        <mxCell id="s2-42" value="&lt;b&gt;Pravilo (sep-05 §60):&lt;/b&gt; važi trenutak inicijalizacije produženja, ne trenutak potvrde. Produženje pokrenuto dok je sesija ACTIVE računa se od starog kraja ako uplata stigne u grace periodu. Kasnija potvrda → automatski refund, sesija ostaje EXPIRED.&lt;br&gt;&lt;b&gt;Zahtevi:&lt;/b&gt; sep-04 §42 (produženje), §50 tačke 6 i 7. T i grace period su oznake iz dizajna (grace = TTL forme). Kafka je izostavljen radi čitljivosti: AttemptResult ide plug-in → PSP preko psp.attempt-results (strana 1).&lt;br&gt;Pune strelice: sinhroni poziv. Isprekidane: odgovor ili asinhrona poruka (webhook, Kafka, callback). Početni koraci plaćanja (POST /orders, POST /api/v1/payments, redirect na checkout) su detaljno na strani „1. Sekvenca: plaćanje karticom“." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1866" width="1050" height="92" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
