          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335.0" y="876" as="sourcePoint" />
            <mxPoint x="1175.0" y="876" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s7-26" value="Gašenje plug-ina" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;align=left;spacingLeft=8;fillColor=#e6e6e6;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="987" width="1240" height="28" as="geometry" />
        </mxCell>
        <mxCell id="s7-27" value="PUT /admin/plugins/{id} {status: DISABLED}" style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="125.0" y="1035" as="sourcePoint" />
            <mxPoint x="335.0" y="1035" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s7-28" value="plugin DISABLED, outbox PluginDisabled, audit_log. Nova plaćanja ne mogu da izaberu metodu; započeti pokušaji se završavaju preko reconciler-a." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="175.0" y="1080" width="320" height="53" as="geometry" />
        </mxCell>
        <mxCell id="s7-29" value="PluginDisabled → psp.registry-events" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="335.0" y="1151" as="sourcePoint" />
            <mxPoint x="545.0" y="1151" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s7-30" value="consume → uklanja provider iz registra" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="545.0" y="1196" as="sourcePoint" />
            <mxPoint x="755.0" y="1196" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s7-31" value="&lt;b&gt;Važno za Kafka:&lt;/b&gt; rezultati plaćanja (psp.attempt-results) idu jednoj instanci, jer sve instance dele consumer grupu (sep-05 §58). Događaji registra moraju stići &lt;b&gt;svakoj&lt;/b&gt; instanci, zato svaka instanca čita psp.registry-events u svojoj grupi (npr. psp-registry-&amp;lt;hostname&amp;gt;). Ovo je dopuna dizajna (predlog).&lt;br&gt;&lt;b&gt;Izvori:&lt;/b&gt; sep-04 §49 (svaki vid plaćanja je plug-in, dodavanje bez gašenja PSP-a); dizajn sep-05 §57 (registar plug-inova, REST/mTLS, tema psp.registry-events). Putanje i polja su predlog.&lt;br&gt;Pune strelice: sinhroni poziv. Isprekidane: odgovor ili asinhrona poruka (webhook, Kafka, callback). Početni koraci plaćanja (POST /orders, POST /api/v1/payments, redirect na checkout) su detaljno na strani „1. Sekvenca: plaćanje karticom“." style="shape=note;whiteSpace=wrap;html=1;size=10;align=left;spacingLeft=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="40" y="1271" width="1260" height="79" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
