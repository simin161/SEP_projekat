        <mxCell id="s6-20" value="200 {passwordChangeRequired} (ograničen token)" style="html=1;verticalAlign=bottom;endArrow=open;endSize=8;dashed=1;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1">
